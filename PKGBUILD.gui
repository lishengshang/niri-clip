# Maintainer: lishengshang <3490017805@qq.com>
# 原生 GUI 分包：iced xdg 窗口，受 niri window-rule 约束。
# CLI 由 niri-clip 主包承载（gui 依赖链需要 libxkbcommon，故独立分包）。
pkgname=niri-clip-gui
_project=niri-clip
pkgver=0.7.0
pkgrel=1
pkgdesc="niri-clip 原生窗口前端，支持中文输入法"
arch=('x86_64' 'aarch64')
url="https://github.com/lishengshang/niri-clip"
license=('MIT')
depends=('glibc' 'libgcc' 'niri-clip' 'wayland' 'libxkbcommon' 'libnotify')
makedepends=('cargo')
# bundled SQLite 的 GCC LTO 对象与 Rust 链接器不兼容。
# Cargo 的 release profile 已剥离符号。
options=('!lto' '!debug')
source=("$_project-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# tag 发布后，在独立的 AUR 配方副本中更新摘要并生成 .SRCINFO，见主包配方。
sha256sums=()

prepare() {
  cd "$srcdir/$_project-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target host-tuple
}

build() {
  cd "$srcdir/$_project-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --release --locked --offline -p "$pkgname"
}

package() {
  cd "$srcdir/$_project-$pkgver"
  install -Dm755 "target/release/niri-clip-gui" "$pkgdir/usr/bin/niri-clip-gui"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "assets/niri-clip.kdl" "$pkgdir/usr/share/doc/$pkgname/niri-clip.kdl.example"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
