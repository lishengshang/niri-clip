[Unit]
Description=niri-clip clipboard daemon
PartOf=graphical-session.target
After=graphical-session.target
Documentation=https://github.com/lishengshang/niri-clip

[Service]
ExecStart=%h/.cargo/bin/niri-clip daemon
Restart=on-failure
RestartSec=2
# 双实例由二进制内 flock 兜底：即使同时配置了 niri spawn-at-startup 也安全

# ── 3.5 沙箱加固（2026-09-26，基线 9.4 UNSAFE，取舍与验收见
#    docs/SECURITY-AUDIT.md §③）──
# 白名单到"daemon + wl-paste/wl-copy/notify-send 子进程"所需最小面：
# AF_UNIX 通信 + 自身 state 目录读写，无网络/设备/capability。
# 网络防线 = RestrictAddressFamilies=AF_UNIX（seccomp 层，user manager 生效）；
# IPAddressDeny 在 user unit 下 systemd 明确警告不生效（IP firewall 需
# root），故不配，避免虚假安全感。前提 systemd >= 248（user manager 支持
# StateDirectory=，目录不存在时自动创建并纳入读写白名单，且跟随自定义
# XDG_STATE_HOME）。
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=niri-clip
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
SystemCallFilter=@system-service
SystemCallFilter=~@resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=niri.service
