# niri-clip v0.4 配置
# 复制到 ~/.config/niri-clip/config.toml 后生效
# 数据库位于 ~/.local/state/niri-clip/db.sqlite（v0.4 起自动从旧 cache 位置搬迁）

max_items = 750
preview_width = 100
min_store_length = 1
enable_image_preview = false  # 图片捕获/chafa 预览（默认关：开启后轮询兜底路径会尝试图片 MIME）
ignore_regex = "(?i)password|secret|token|otp|auth"
pinned_on_top = true
tui_backend = "auto"      # auto | native | fzf | fuzzel
                          # native: 原生 iced xdg 窗口（需 niri-clip-gui，见 ADR-001）
                          # auto: gui 可用优先 native，其次 fzf，最后 fuzzel
notify_enabled = true     # v0.5（P1-4）：桌面通知开关（mako 等），false 完全静默
enable_preview = true
# v0.4.1：事件驱动捕获下每次子进程的超时秒数（防病态读挂起）
capture_timeout_secs = 5
# v0.5.2（1.1）：PRIMARY selection 选中即捕获（鼠标划选的文本也入库，
# 中键粘贴语义）。与剪贴板同去重空间；默认关——划选噪声大
capture_primary = false
# v0.5：单条入库体积上限（字节）。超限拒绝入库并通知；防 DB 膨胀与全内存直通
max_clip_bytes = 1048576    # 1 MiB（文本）
max_image_bytes = 10485760  # 10 MiB（图片，截图通常 1–3MB）
# v0.5.1（1.3）：images/ 目录总量配额（字节），daemon 启动时超限按 LRU 淘汰
# 最旧图片条目（星标/当前项受保护）；0 = 不限制
max_image_total_bytes = 209715200  # 200 MiB
